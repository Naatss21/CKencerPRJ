<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D0F0E7">

    <LinearLayout
        android:id="@+id/patternSubdivisionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/patternBinaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Binaire" />

        <Button
            android:id="@+id/patternTernaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ternaire " />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/patternStepsContainer"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/patternSubdivisionRow" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/patternStepsContainer">


        <Button
            android:id="@+id/patternStopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="Stop" />


        <Button
            android:id="@+id/metronomeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Métro OFF" />

        <TextView
            android:id="@+id/beatIndicatorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_gravity="center_vertical"
            android:text="1/4"
            android:textColor="#2F2222"
            android:textSize="18sp" />

        <Button
            android:id="@+id/patternPlayButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play/Pause"
            tools:layout_editor_absoluteX="71dp"
            tools:layout_editor_absoluteY="253dp" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>